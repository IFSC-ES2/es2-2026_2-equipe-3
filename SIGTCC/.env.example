# Configurações do MySQL (Docker)
MYSQL_DATABASE=gestao_tcc
MYSQL_USER=tcc_user
MYSQL_PASSWORD=tcc_password
MYSQL_ROOT_PASSWORD=root_password

# Configurações do Spring Boot
SPRING_DATASOURCE_URL=jdbc:mysql://db:3306/gestao_tcc?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=tcc_user
SPRING_DATASOURCE_PASSWORD=tcc_password

# Configurações do Keycloak
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=admin_password

# Configurações do Keycloak consumidas pelo frontend (Vite)
VITE_KEYCLOAK_URL=http://localhost:8081
VITE_KEYCLOAK_REALM=sigtcc
VITE_KEYCLOAK_CLIENT_ID=sigtcc-frontend

# Submissão de entregas por link externo (US06 / ADR-0013)
# A submissão é feita exclusivamente via URL (sem upload/volume de arquivos).
# Lista (separada por vírgula) de domínios sugeridos ao aluno como dica na interface
# (ex.: Google Drive, GitHub, OneDrive). É apenas uma sugestão de UX: o backend aceita
# QUALQUER URL com protocolo https:// válido, não somente os domínios listados abaixo.
APP_SUBMISSAO_DOMINIOS_SUGERIDOS=drive.google.com,github.com,onedrive.live.com
