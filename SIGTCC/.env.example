# ==============================================================
# ARQUIVO DE EXEMPLO - VARIÁVEIS DE AMBIENTE (SIGTCC)
# Copie este arquivo para "SIGTCC/.env" (ou ".env" na raiz ao usar --env-file)
# e ajuste os valores localmente conforme o ambiente.
# Nunca commite senhas reais ou URLs públicas definitivas no repositório.
# ==============================================================

# --- Configurações do MySQL (Docker) ---
MYSQL_DATABASE=gestao_tcc
MYSQL_USER=tcc_user
MYSQL_PASSWORD=senha_exemplo_db
MYSQL_ROOT_PASSWORD=senha_exemplo_root

# --- Configurações do Spring Boot (Backend) ---
SPRING_DATASOURCE_URL=jdbc:mysql://db:3306/gestao_tcc?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=tcc_user
SPRING_DATASOURCE_PASSWORD=senha_exemplo_db

# --- Configurações do Keycloak (IAM) ---
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=admin_senha

# --- Configurações do Keycloak consumidas pelo Frontend (Vite) ---
VITE_KEYCLOAK_URL=http://localhost:8081
VITE_KEYCLOAK_REALM=sigtcc
VITE_KEYCLOAK_CLIENT_ID=sigtcc-frontend

# --- Submissão de Entregas por Link Externo (US06 / ADR-0013) ---
# Lista (separada por vírgula) de domínios sugeridos ao aluno como dica de UX na interface.
# O backend aceita qualquer URL com protocolo https:// válido.
APP_SUBMISSAO_DOMINIOS_SUGERIDOS=drive.google.com,github.com,onedrive.live.com

# --- Configurações de Staging / Produção (docker-compose.prod.yml) ---
VITE_API_URL=http://localhost:8080
KEYCLOAK_HOSTNAME=localhost
APP_CORS_ALLOWED_ORIGINS=http://localhost
